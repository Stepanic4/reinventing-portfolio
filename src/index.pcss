@import "tailwindcss";
@variant dark (&:where(.dark, .dark *));

body {
  @apply bg-amber-50/50 text-slate-900;
  @apply transition-all duration-500;
  margin: 0;
}

@layer components {
  .btn-nav-shadow {
    @apply text-amber-950 dark:text-slate-200 font-medium;
    @apply px-5 py-2 rounded-xl border transition-all duration-300 cursor-pointer;

    /* Включаем размытие заднего фона */
    @apply backdrop-blur-md;

    /* --- СВЕТЛАЯ ТЕМА --- */
    background: linear-gradient(
      180deg,
      rgba(235, 230, 210, 0.5) 0%,
      rgba(255, 255, 255, 0.15) 100%
    );
    border-color: rgba(255, 255, 255, 0.2);

    /* тени для 3D-эффекта */
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.4),
      inset 0 -1px 1px rgba(0, 0, 0, 0.3),
      0 4px 6px rgba(0, 0, 0, 0.4);

    @apply hover:scale-105 hover:-translate-y-1 hover:text-yellow-600 dark:hover:text-blue-200 [text-shadow:0_1px_2px_rgba(0,0,0,0.1)];

    /* --- ТЕМНАЯ ТЕМА --- */
    @variant dark {
      /* Прозрачность в темной теме */
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.05) 0%,
        rgba(255, 255, 255, 0.01) 100%
      );
      border-color: rgba(255, 255, 255, 0.15);

      /* тени темной темы */
      box-shadow:
        inset 0 1px 1px rgba(255, 255, 255, 0.2),
        inset 0 -1px 1px rgba(0, 0, 0, 0.3),
        0 4px 6px rgba(0, 0, 0, 0.4);

      &:hover {
        background: linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.1) 0%,
          rgba(255, 255, 255, 0.03) 100%
        );
        border-color: rgba(255, 255, 255, 0.3);
        box-shadow:
          inset 0 1px 2px rgba(255, 255, 255, 0.4),
          0 0 20px 5px rgba(59, 130, 246, 0.3),
          0 10px 15px -3px rgba(0, 0, 0, 0.5);
      }
    }

    /* Эффект нажатия */
    &:active {
      @apply scale-95 translate-y-0;
      box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.6);
    }
  }
}

@keyframes triangle-pulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.3;
  }
  50% {
    transform: scale(1.15);
    opacity: 0.8;
  }
}

.animate-triangle {
  animation: triangle-pulse 1.5s infinite ease-in-out;
}

/* --- НАСТРОЙКИ ПЕЧАТИ (PDF) --- */
@page {
  size: A4;
  margin: 0;
}

@media print {
  html,
  body {
    width: 210mm;
    height: 296mm !important; /* Убавили 1мм для защиты от субпиксельного переполнения на мобилках */
    margin: 0 !important;
    padding: 0 !important;
    background: white;
    overflow: hidden !important; /* Жестко отсекаем любые невидимые хвосты */
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .resume-sheet {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    margin: 0 !important;
    width: 210mm !important;
    height: 296mm !important;
    max-height: 296mm !important;
    overflow: hidden !important;
    box-shadow: none !important;
    page-break-after: avoid !important;
    page-break-inside: avoid !important;
  }

  /* Гарантируем, что внешние обертки не дают отступов */
  #root,
  .resume-page-container {
    margin: 0 !important;
    padding: 0 !important;
    min-height: 0 !important;
  }
}

/* --- АНИМАЦИЯ КНОПКИ --- */
@keyframes pulse-shadow {
  0% {
    box-shadow: 0 0 0 0 rgba(6, 182, 212, 0.4);
  }
  70% {
    box-shadow: 0 0 0 15px rgba(6, 182, 212, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(6, 182, 212, 0);
  }
}

.animate-pulse-shadow {
  animation: pulse-shadow 2s infinite ease-in-out;
}

.animate-pulse-shadow:hover {
  animation: none;
  box-shadow: none;
}
